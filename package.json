{
  "name": "greek-flashcards",
  "version": "1.0.0",
  "description": "Greek vocabulary flashcard app",
  "homepage": "./",
  "main": "electron/main.js",
  "scripts": {
    "start": "concurrently \"cross-env BROWSER=none react-scripts start\" \"wait-on http://localhost:3000 && electron .\"",
    "react-start": "react-scripts start",
    "build": "react-scripts build",
    "electron-build": "npm run build && electron-builder",
    "electron-build:win": "npm run build && electron-builder --win --config.win.signingHashAlgorithms=[] --config.win.sign=null",
    "electron-build:mac": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-packager . \"Greek Flashcards\" --platform=win32 --arch=x64 --out=dist --overwrite --ignore=src --ignore=node_modules/.cache --ignore=.git",
    "installer": "node scripts/build-installer.js",
    "installer:mac": "bash scripts/build-mac.sh"
  },
  "dependencies": {
    "papaparse": "^5.4.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "electron": "^28.3.3",
    "electron-builder": "^24.9.1",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.greek.flashcards",
    "productName": "Greek Flashcards",
    "extends": null,
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "build/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signingHashAlgorithms": null,
      "sign": null
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "public/icon.icns",
      "category": "public.app-category.education"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "browserslist": {
    "production": [
      "last 1 electron version"
    ],
    "development": [
      "last 1 electron version"
    ]
  },
  "allowScripts": {
    "electron@28.3.3": true,
    "core-js@3.50.0": true,
    "core-js-pure@3.50.0": true
  }
}
